# ── Storage ───────────────────────────────────────────────────────────────────
# "json" (files in ./data, single user) or "supabase" (Postgres + Auth + RLS)
LEDGER_DB_PROVIDER=json
# LEDGER_DATA_DIR=./data

# ── JSON mode login (single user) ─────────────────────────────────────────────
# Password for the login page. Use a long passphrase.
LEDGER_PASSWORD=
# Signs the session cookie. Generate: openssl rand -base64 48
LEDGER_SESSION_SECRET=
# Dev only: skip login entirely (refused when NODE_ENV=production)
# LEDGER_AUTH_DISABLED=true

# ── Supabase mode ─────────────────────────────────────────────────────────────
# Project Settings → API. Server-side only — never prefix with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
# anon / publishable key. Every request also carries the signed-in user's JWT; RLS enforces access.
SUPABASE_ANON_KEY=

# Admin key — ONLY for `npm run db:migrate-json`. The app never reads it.
# Keep it out of your hosting provider's env vars.
SUPABASE_SERVICE_ROLE_KEY=
